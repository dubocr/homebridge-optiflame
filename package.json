        "homebridge-lib": "^8.1.3",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.6.0",
        "eslint": "^10.3.0",
        "homebridge": "^2.0.0",
        "nodemon": "^3.1.14",
        "rimraf": "^6.1.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.2"
    }
