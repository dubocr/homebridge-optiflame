{
    "name": "homebridge-optiflame",
    "displayName": "Optiflame",
    "type": "module",
    "version": "1.0.3",
    "description": "Optiflame pluging for Homebridge",
    "author": "Romain DUBOC <romain@duboc.pro>",
    "license": "MIT",
    "homepage": "https://github.com/dubocr/homebridge-optiflame#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/dubocr/homebridge-optiflame.git"
    },
    "bugs": {
        "url": "https://github.com/dubocr/homebridge-optiflame/issues"
    },
    "keywords": [
        "homebridge-plugin"
    ],
    "main": "dist/index.js",
    "engines": {
        "node": "^22.10.0 || ^24.0.0",
        "homebridge": "^1.8.0 || ^2.0.0"
